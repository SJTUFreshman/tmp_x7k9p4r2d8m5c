#!/usr/bin/env bash

# Corrected MATH-only reproduction of the GSM fixed-A1 SFT -> rollout -> RL
# method. Every value can be overridden before invoking a stage.

EXPERIMENT_ROOT="${EXPERIMENT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
BUNDLED_PROJECT_ROOT="${BUNDLED_PROJECT_ROOT:-${EXPERIMENT_ROOT}/vendor/jca}"
BUNDLED_PYTHONPATH_ROOT="${BUNDLED_PYTHONPATH_ROOT:-${EXPERIMENT_ROOT}/vendor}"
RESOURCE_PROJECT_ROOT="${RESOURCE_PROJECT_ROOT:-/data/wangyuheng/jca}"
PROJECT_ROOT="$BUNDLED_PROJECT_ROOT"
PYTHONPATH_ROOT="$BUNDLED_PYTHONPATH_ROOT"
PYTHON_BIN="${PYTHON_BIN:-/data/conda_envs/qwen35/bin/python}"
VLLM_PYTHON_BIN="${VLLM_PYTHON_BIN:-/data/conda_envs/deep_research/bin/python}"
VLLM_LD_LIBRARY_PATH="${VLLM_LD_LIBRARY_PATH:-/data/conda_envs/deep_research/lib}"
ACCELERATE="${ACCELERATE:-/data/conda_envs/qwen35/bin/accelerate}"
UPSTREAM_MATH_ROOT="${UPSTREAM_MATH_ROOT:-${PROJECT_ROOT}/experiments/math_rl_mas_thinking}"

TAG="${TAG:-math_specific_sft_rl_v1}"
ARTIFACT_ROOT="${ARTIFACT_ROOT:-${EXPERIMENT_ROOT}/artifacts/${TAG}}"
LOG_ROOT="${LOG_ROOT:-${ARTIFACT_ROOT}/logs}"
MATH_DATA_ROOT="${MATH_DATA_ROOT:-${RESOURCE_PROJECT_ROOT}/Math/data/MATH}"

MODEL_A1="${MODEL_A1:-/data/wangyuheng/models/Qwen3-1.7B}"
MODEL_A2="${MODEL_A2:-/data/wangyuheng/models/Qwen3-4B}"
MODEL_A3="${MODEL_A3:-/data/wangyuheng/models/Qwen3-8B}"
MODEL_14B="${MODEL_14B:-/data/wangyuheng/models/Qwen3-14B}"

# Stage 00/01: MATH-specific fixed-A1 protocol SFT.
SFT_DATA_DIR="${SFT_DATA_DIR:-${ARTIFACT_ROOT}/00_sft_data}"
SFT_ROLLOUT_FILE="${SFT_ROLLOUT_FILE:-${ARTIFACT_ROOT}/00_sft_rollout/train_accepted.jsonl}"
SFT_ROLLOUT_LOG_ROOT="${SFT_ROLLOUT_LOG_ROOT:-${ARTIFACT_ROOT}/00_sft_rollout/logs}"
SFT_ROLLOUT_MODEL="${SFT_ROLLOUT_MODEL:-${MODEL_A3}}"
SFT_ROLLOUT_LIMIT="${SFT_ROLLOUT_LIMIT:-3160}"
SFT_ROLLOUT_MAX_MISSING="${SFT_ROLLOUT_MAX_MISSING:-40}"
SFT_ROLLOUT_START="${SFT_ROLLOUT_START:-0}"
SFT_ROLLOUT_PLAN_OFFSET="${SFT_ROLLOUT_PLAN_OFFSET:-0}"
SFT_ROLLOUT_MAX_CONCURRENCY="${SFT_ROLLOUT_MAX_CONCURRENCY:-64}"
SFT_ROLLOUT_MAX_NEW_TOKENS="${SFT_ROLLOUT_MAX_NEW_TOKENS:-2048}"
SFT_ROLLOUT_TEMPERATURE="${SFT_ROLLOUT_TEMPERATURE:-0.2}"
SFT_ROLLOUT_TOP_P="${SFT_ROLLOUT_TOP_P:-0.95}"
SFT_ROLLOUT_MAX_STEP_RETRIES="${SFT_ROLLOUT_MAX_STEP_RETRIES:-2}"
SFT_ROLLOUT_MAX_TRAJECTORY_ATTEMPTS="${SFT_ROLLOUT_MAX_TRAJECTORY_ATTEMPTS:-20}"
SFT_ROLLOUT_MAX_VERIFIER_SIMILARITY="${SFT_ROLLOUT_MAX_VERIFIER_SIMILARITY:-0.85}"
SFT_ROLLOUT_LAUNCH_ATTEMPTS="${SFT_ROLLOUT_LAUNCH_ATTEMPTS:-3}"
SFT_RUN_ROOT="${SFT_RUN_ROOT:-${ARTIFACT_ROOT}/01_sft/adapters}"
SFT_A1="${SFT_A1:-${SFT_RUN_ROOT}/A1/final}"
SFT_A2="${SFT_A2:-${SFT_RUN_ROOT}/A2/final}"
SFT_A3="${SFT_A3:-${SFT_RUN_ROOT}/A3/final}"
SFT_SAMPLES_PER_AGENT="${SFT_SAMPLES_PER_AGENT:-2200}"
SFT_CORRECTION_FRACTION="${SFT_CORRECTION_FRACTION:-0.30}"
SFT_SEED="${SFT_SEED:-42}"
SFT_NUM_EPOCHS="${SFT_NUM_EPOCHS:-3}"
SFT_LR="${SFT_LR:-1e-5}"
SFT_EVAL_FRACTION="${SFT_EVAL_FRACTION:-0.05}"
SFT_MAX_SEQ="${SFT_MAX_SEQ:-4096}"
SFT_MAX_TOKENIZATION_DROP_RATIO="${SFT_MAX_TOKENIZATION_DROP_RATIO:-0.05}"
SFT_PER_DEVICE_BATCH="${SFT_PER_DEVICE_BATCH:-1}"
SFT_GRAD_ACCUM="${SFT_GRAD_ACCUM:-4}"
SFT_LORA_RANK="${SFT_LORA_RANK:-64}"
SFT_LORA_ALPHA="${SFT_LORA_ALPHA:-64}"
SFT_LORA_DROPOUT="${SFT_LORA_DROPOUT:-0.05}"
SFT_EVAL_STEPS="${SFT_EVAL_STEPS:-50}"
SFT_SAVE_STEPS="${SFT_SAVE_STEPS:-50}"
SFT_SAVE_TOTAL_LIMIT="${SFT_SAVE_TOTAL_LIMIT:-10}"
SFT_REPORT_TO="${SFT_REPORT_TO:-none}"

# Stage 02: fresh MATH-train rollout from the MATH-specific SFT adapters.
RAW_ROLLOUT="${RAW_ROLLOUT:-${ARTIFACT_ROOT}/02_sample/train_raw.jsonl}"
SAMPLE_STATE="${SAMPLE_STATE:-${ARTIFACT_ROOT}/02_sample/trajectory_state.json}"
REUSED_RAW_SOURCE="${REUSED_RAW_SOURCE:-${RESOURCE_PROJECT_ROOT}/experiments/math_rl_mas_thinking/artifacts/math_rl_mas_v13_nonthinking_global_turn_json_object_1p7b_4b_8b_corrected_v4d/01_sample/train_raw_normalized.jsonl}"
REUSE_NORMALIZATION_STATS="${REUSE_NORMALIZATION_STATS:-${ARTIFACT_ROOT}/02_reuse/normalization_stats.json}"
REUSE_JUDGE_SCORES="${REUSE_JUDGE_SCORES:-0}"
REUSED_JUDGED_SOURCE="${REUSED_JUDGED_SOURCE:-${RESOURCE_PROJECT_ROOT}/experiments/math_rl_mas_thinking/artifacts/math_rl_mas_v13_nonthinking_global_turn_json_object_1p7b_4b_8b_corrected_v4d/02_score/train_judged_corrected.jsonl}"
JUDGE_REUSE_STATS="${JUDGE_REUSE_STATS:-${ARTIFACT_ROOT}/03_score/reuse_stats.json}"
JUDGE_SERVED_MODEL_NAME="${JUDGE_SERVED_MODEL_NAME:-qwen14b_gsm_judge}"
TRAIN_START="${TRAIN_START:-0}"
TRAIN_LIMIT="${TRAIN_LIMIT:-7500}"
SUBJECTS="${SUBJECTS:-}"
NUM_ROLLOUTS="${NUM_ROLLOUTS:-8}"
T_MAX="${T_MAX:-8}"
MIN_AGENTS_BEFORE_STOP="${MIN_AGENTS_BEFORE_STOP:-1}"
SAMPLE_START_AGENT="${SAMPLE_START_AGENT:-A1}"
SAMPLE_TEMPERATURE="${SAMPLE_TEMPERATURE:-0.9}"
SAMPLE_TOP_P="${SAMPLE_TOP_P:-0.95}"
SAMPLE_MAX_NEW_TOKENS="${SAMPLE_MAX_NEW_TOKENS:-8192}"
SAMPLE_MAX_CONCURRENCY="${SAMPLE_MAX_CONCURRENCY:-128}"
SAMPLE_JSON_TRANSPORT="${SAMPLE_JSON_TRANSPORT:-json_object}"
SAMPLE_GROUP_RETRIES="${SAMPLE_GROUP_RETRIES:-5}"
SAMPLE_STEP_RETRIES="${SAMPLE_STEP_RETRIES:-4}"
SAMPLE_GENERATION_SEED="${SAMPLE_GENERATION_SEED:-42}"
SAMPLE_ENABLE_THINKING="${SAMPLE_ENABLE_THINKING:-0}"
SAMPLE_REQUIRE_THINKING="${SAMPLE_REQUIRE_THINKING:-0}"
TRAIN_ENABLE_THINKING="${TRAIN_ENABLE_THINKING:-0}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-40960}"
API_TIMEOUT="${API_TIMEOUT:-1800}"

# Stage 03: fresh Qwen3-14B process scoring.
JUDGED_ROLLOUT="${JUDGED_ROLLOUT:-${ARTIFACT_ROOT}/03_score/train_judged.jsonl}"
JUDGE_STATS="${JUDGE_STATS:-${ARTIFACT_ROOT}/03_score/stats.json}"
JUDGE_MODEL_PATH="${JUDGE_MODEL_PATH:-${MODEL_14B}}"
JUDGE_MAX_MODEL_LEN="${JUDGE_MAX_MODEL_LEN:-32768}"
JUDGE_MAX_TOKENS="${JUDGE_MAX_TOKENS:-8192}"
JUDGE_CONCURRENCY="${JUDGE_CONCURRENCY:-16}"
JUDGE_GROUP_RETRIES="${JUDGE_GROUP_RETRIES:-2}"
JUDGE_PARSE_RETRIES="${JUDGE_PARSE_RETRIES:-2}"
JUDGE_AUTO_RESUME_PASSES="${JUDGE_AUTO_RESUME_PASSES:-5}"
JUDGE_TEMPERATURE="${JUDGE_TEMPERATURE:-0.0}"
JUDGE_TOP_P="${JUDGE_TOP_P:-0.95}"

# Stage 04: fresh success-mix preparation, then conservative-AWR annotation.
PREPARE_BASE_ROOT="${PREPARE_BASE_ROOT:-${ARTIFACT_ROOT}/04_prepare/base_v13}"
PREPARE_BASE_TRAIN="${PREPARE_BASE_TRAIN:-${PREPARE_BASE_ROOT}/train.jsonl}"
PREPARE_BASE_HOLDOUT="${PREPARE_BASE_HOLDOUT:-${PREPARE_BASE_ROOT}/holdout.jsonl}"
PREPARE_BASE_STATS="${PREPARE_BASE_STATS:-${PREPARE_BASE_ROOT}/stats.json}"
PREPARE_BASE_MANIFEST="${PREPARE_BASE_MANIFEST:-${PREPARE_BASE_ROOT}/manifest.json}"
TRAIN_DATA="${TRAIN_DATA:-${ARTIFACT_ROOT}/04_prepare/awr/train.jsonl}"
HOLDOUT_DATA="${HOLDOUT_DATA:-${ARTIFACT_ROOT}/04_prepare/awr/holdout.jsonl}"
PREPARE_STATS="${PREPARE_STATS:-${ARTIFACT_ROOT}/04_prepare/awr/stats.json}"
MANIFEST="${MANIFEST:-${ARTIFACT_ROOT}/manifest.json}"
HOLDOUT_FRACTION="${HOLDOUT_FRACTION:-0.10}"
MIX_A1_CORRECT="${MIX_A1_CORRECT:-0.30}"
MIX_NO_CORRECTION="${MIX_NO_CORRECTION:-0.20}"
MIX_CORRECTION_SUCCESS="${MIX_CORRECTION_SUCCESS:-0.35}"
MIX_CORRECTION_FAILED="${MIX_CORRECTION_FAILED:-0.15}"
BASE_REWARD_WEIGHT="${BASE_REWARD_WEIGHT:-0.35}"
JUDGE_REWARD_WEIGHT="${JUDGE_REWARD_WEIGHT:-0.65}"
TRANSITION_BOOST="${TRANSITION_BOOST:-1.25}"
CORRECT_TO_CORRECT_COEF_A1="${CORRECT_TO_CORRECT_COEF_A1:-1.0}"
CORRECT_TO_CORRECT_COEF_A2="${CORRECT_TO_CORRECT_COEF_A2:-0.5}"
CORRECT_TO_CORRECT_COEF_A3="${CORRECT_TO_CORRECT_COEF_A3:-1.0}"
RL_SAMPLE_SOURCE_V4="${RL_SAMPLE_SOURCE_V4:-math_specific_sft_judged_signed_awr}"
RL_SAMPLING_POLICY_LINEAGE="${RL_SAMPLING_POLICY_LINEAGE:-MATH-specific SFT}"
RL_REUSE_LEGACY_SAMPLED_DATA="${RL_REUSE_LEGACY_SAMPLED_DATA:-0}"

# Stage 05: role-by-role conservative signed AWR. The trainer loads SFT_A* as
# both the trainable policy initialization and the separate frozen reference.
RL_ROOT="${RL_ROOT:-${ARTIFACT_ROOT}/05_train/adapters}"
REFERENCE_COEF="${REFERENCE_COEF:-0.10}"
PROTOCOL_REFERENCE_COEF="${PROTOCOL_REFERENCE_COEF:-1.0}"
PROTOCOL_REFERENCE_MARGIN="${PROTOCOL_REFERENCE_MARGIN:-0.05}"
NEGATIVE_MARGIN="${NEGATIVE_MARGIN:-0.5}"
NEGATIVE_MASK_POLICY="${NEGATIVE_MASK_POLICY:-role_aware}"
DANGEROUS_DECISION_COEF="${DANGEROUS_DECISION_COEF:-0.25}"
POSITIVE_STOP_DECISION_COEF="${POSITIVE_STOP_DECISION_COEF:-0.10}"
RL_NUM_EPOCHS="${RL_NUM_EPOCHS:-1}"
RL_LR="${RL_LR:-1e-6}"
RL_PER_DEVICE_BATCH="${RL_PER_DEVICE_BATCH:-1}"
RL_GRAD_ACCUM="${RL_GRAD_ACCUM:-2}"
RL_MAX_SEQ="${RL_MAX_SEQ:-8192}"
RL_LOGGING_STEPS="${RL_LOGGING_STEPS:-10}"
RL_SAVE_STEPS="${RL_SAVE_STEPS:-25}"
RL_SAVE_TOTAL_LIMIT="${RL_SAVE_TOTAL_LIMIT:-50}"
RL_MAX_ATTEMPTS="${RL_MAX_ATTEMPTS:-3}"

# Stage 06: one immutable, shared 500-problem evaluation shard.
EVAL_SHARD_FILE="${EVAL_SHARD_FILE:-${MATH_DATA_ROOT}/splits/test_10x500_seed42/shard_04.jsonl}"
EVAL_DATA_ROOT="${EVAL_DATA_ROOT:-${ARTIFACT_ROOT}/06_eval/data/shard_04}"
EVAL_ROOT="${EVAL_ROOT:-${ARTIFACT_ROOT}/06_eval}"
EVAL_LIMIT="${EVAL_LIMIT:-500}"
EVAL_START="${EVAL_START:-0}"
EVAL_T_MAX="${EVAL_T_MAX:-12}"
EVAL_BOOTSTRAP_AGENT="${EVAL_BOOTSTRAP_AGENT:-A3}"
EVAL_START_AGENT_SEED="${EVAL_START_AGENT_SEED:-43}"
EVAL_GENERATION_SEED="${EVAL_GENERATION_SEED:-42}"
EVAL_TEMPERATURE="${EVAL_TEMPERATURE:-0.0}"
EVAL_TOP_P="${EVAL_TOP_P:-0.95}"
EVAL_MAX_NEW_TOKENS="${EVAL_MAX_NEW_TOKENS:-8192}"
EVAL_MAX_CONCURRENCY="${EVAL_MAX_CONCURRENCY:-256}"
EVAL_GROUP_RETRIES="${EVAL_GROUP_RETRIES:-0}"
EVAL_STEP_RETRIES="${EVAL_STEP_RETRIES:-2}"
ENABLE_THINKING="${ENABLE_THINKING:-0}"
REQUIRE_THINKING="${REQUIRE_THINKING:-0}"
ALLOW_THINKING_MODE_MISMATCH="${ALLOW_THINKING_MODE_MISMATCH:-0}"
EVAL_CHECKPOINT_SWEEP="${EVAL_CHECKPOINT_SWEEP:-1}"
EVAL_CHECKPOINT_STEPS="${EVAL_CHECKPOINT_STEPS:-auto}"
BARE_ADAPTER_ROOT="${BARE_ADAPTER_ROOT:-${ARTIFACT_ROOT}/06_eval/bare_adapters}"

SEED="${SEED:-42}"
NUM_GPUS="${NUM_GPUS:-8}"
MIXED_PRECISION="${MIXED_PRECISION:-bf16}"
RESUME="${RESUME:-1}"
DRY_RUN="${DRY_RUN:-0}"
WAIT_FOR_GPUS="${WAIT_FOR_GPUS:-1}"
GPU_IDS="${GPU_IDS:-0,1,2,3,4,5,6,7}"
GPU_POLL_SECONDS="${GPU_POLL_SECONDS:-60}"
GPU_IDLE_CHECKS="${GPU_IDLE_CHECKS:-2}"
GPU_IDLE_MAX_MEMORY_MIB="${GPU_IDLE_MAX_MEMORY_MIB:-2048}"
GPU_IDLE_TIMEOUT_SECONDS="${GPU_IDLE_TIMEOUT_SECONDS:-86400}"
LOCK_PATH="${LOCK_PATH:-${RESOURCE_PROJECT_ROOT}/logs/gsm_hard_all/.lock}"
