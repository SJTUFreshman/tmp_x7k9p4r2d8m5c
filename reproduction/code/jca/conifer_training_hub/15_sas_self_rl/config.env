#!/usr/bin/env bash

PROJECT_ROOT="${PROJECT_ROOT:-/data/wangyuheng/jca}"
CONIFER_ROOT="${CONIFER_ROOT:-${PROJECT_ROOT}/conifer_training_hub}"
SCRIPT_DIR="${SCRIPT_DIR:-${CONIFER_ROOT}/15_sas_self_rl}"
PYTHON_BIN="${PYTHON_BIN:-/data/conda_envs/qwen35/bin/python}"
ACCELERATE="${ACCELERATE:-/data/conda_envs/qwen35/bin/accelerate}"
VLLM_PYTHON_BIN="${VLLM_PYTHON_BIN:-/data/conda_envs/drb_py311_clean/bin/python}"
VLLM_LD_LIBRARY_PATH="${VLLM_LD_LIBRARY_PATH:-/data/conda_envs/drb_py311_clean/lib}"
PYTHONPATH_ROOT="${PYTHONPATH_ROOT:-/data/wangyuheng}"

MODEL_8B="${MODEL_8B:-/data/wangyuheng/models/Qwen3-8B}"
MODEL_14B="${MODEL_14B:-/data/wangyuheng/models/Qwen3-14B}"
TRAIN_DATA="${TRAIN_DATA:-${CONIFER_ROOT}/01_dataset/processed/train.jsonl}"
TEST_DATA="${TEST_DATA:-${CONIFER_ROOT}/01_dataset/processed/test.jsonl}"

RUN_ID="${RUN_ID:-conifer_3x8b_then_sas14b_self_rl_$(date +%Y%m%d_%H%M%S)}"
RUN_DIR="${RUN_DIR:-${CONIFER_ROOT}/10_outputs/${RUN_ID}}"
LOG_DIR="${LOG_DIR:-${CONIFER_ROOT}/09_logs/sas_self_rl/${RUN_ID}}"

MAS_EVAL_OUTPUT="${MAS_EVAL_OUTPUT:-${RUN_DIR}/00_3x8b_zero_shot/trajectories.jsonl}"
MAS_EVAL_SCORED="${MAS_EVAL_SCORED:-${RUN_DIR}/00_3x8b_zero_shot/scored.jsonl}"
MAS_EVAL_RL_RECORDS="${MAS_EVAL_RL_RECORDS:-${RUN_DIR}/00_3x8b_zero_shot/rl_records.jsonl}"
MAS_EVAL_SUMMARY="${MAS_EVAL_SUMMARY:-${RUN_DIR}/00_3x8b_zero_shot/summary.json}"

RAW_ROLLOUT="${RAW_ROLLOUT:-${RUN_DIR}/01_sas_rollout/train_raw.jsonl}"
ROLLOUT_STATS="${ROLLOUT_STATS:-${RUN_DIR}/01_sas_rollout/stats.json}"
JUDGED_ROLLOUT="${JUDGED_ROLLOUT:-${RUN_DIR}/02_sas_judge/train_judged.jsonl}"
JUDGE_AUDIT="${JUDGE_AUDIT:-${RUN_DIR}/02_sas_judge/audit.jsonl}"
JUDGE_STATS="${JUDGE_STATS:-${RUN_DIR}/02_sas_judge/stats.json}"
TRAIN_OUT="${TRAIN_OUT:-${CONIFER_ROOT}/11_runs/sas_self_rl/${RUN_ID}}"
BASE_EVAL_OUTPUT="${BASE_EVAL_OUTPUT:-${RUN_DIR}/04_sas_eval/base_test.jsonl}"
BASE_EVAL_SUMMARY="${BASE_EVAL_SUMMARY:-${RUN_DIR}/04_sas_eval/base_summary.json}"
RL_EVAL_OUTPUT="${RL_EVAL_OUTPUT:-${RUN_DIR}/04_sas_eval/rl_test.jsonl}"
RL_EVAL_SUMMARY="${RL_EVAL_SUMMARY:-${RUN_DIR}/04_sas_eval/rl_summary.json}"

MAS_EVAL_START="${MAS_EVAL_START:-0}"
MAS_EVAL_LIMIT="${MAS_EVAL_LIMIT:-0}"
MAS_EVAL_NUM_ROLLOUTS="${MAS_EVAL_NUM_ROLLOUTS:-1}"
MAS_EVAL_START_AGENT="${MAS_EVAL_START_AGENT:-balanced}"
MAS_EVAL_START_AGENT_SEED="${MAS_EVAL_START_AGENT_SEED:-42}"
MAS_EVAL_TEMPERATURE="${MAS_EVAL_TEMPERATURE:-0.0}"
MAS_EVAL_TOP_P="${MAS_EVAL_TOP_P:-0.95}"
MAS_EVAL_MAX_NEW_TOKENS="${MAS_EVAL_MAX_NEW_TOKENS:-1536}"
MAS_EVAL_PROTOCOL_MAX_NEW_TOKENS="${MAS_EVAL_PROTOCOL_MAX_NEW_TOKENS:-1024}"
MAS_EVAL_MAX_CONCURRENCY="${MAS_EVAL_MAX_CONCURRENCY:-768}"

TRAIN_START="${TRAIN_START:-0}"
TRAIN_LIMIT="${TRAIN_LIMIT:-0}"
NUM_ROLLOUTS="${NUM_ROLLOUTS:-2}"
ROLLOUT_TEMPERATURE="${ROLLOUT_TEMPERATURE:-0.9}"
ROLLOUT_TOP_P="${ROLLOUT_TOP_P:-0.95}"
ROLLOUT_MAX_NEW_TOKENS="${ROLLOUT_MAX_NEW_TOKENS:-2048}"
ROLLOUT_CONCURRENCY="${ROLLOUT_CONCURRENCY:-512}"
PROTOCOL_RETRIES="${PROTOCOL_RETRIES:-2}"
ROLLOUT_AUTO_RESUME_PASSES="${ROLLOUT_AUTO_RESUME_PASSES:-3}"
# Training data only; the eval denominator is never subject to this tolerance.
ROLLOUT_MAX_MISSING_FRACTION="${ROLLOUT_MAX_MISSING_FRACTION:-0.005}"

JUDGE_TEMPERATURE="${JUDGE_TEMPERATURE:-0.0}"
JUDGE_TOP_P="${JUDGE_TOP_P:-0.95}"
JUDGE_MAX_NEW_TOKENS="${JUDGE_MAX_NEW_TOKENS:-1536}"
JUDGE_CONCURRENCY="${JUDGE_CONCURRENCY:-512}"
JUDGE_RETRIES="${JUDGE_RETRIES:-2}"
JUDGE_AUTO_RESUME_PASSES="${JUDGE_AUTO_RESUME_PASSES:-3}"
OUTCOME_WEIGHT="${OUTCOME_WEIGHT:-0.5}"
PROCESS_WEIGHT="${PROCESS_WEIGHT:-0.5}"

EVAL_START="${EVAL_START:-0}"
EVAL_LIMIT="${EVAL_LIMIT:-0}"
EVAL_TEMPERATURE="${EVAL_TEMPERATURE:-0.0}"
EVAL_TOP_P="${EVAL_TOP_P:-0.95}"
EVAL_MAX_NEW_TOKENS="${EVAL_MAX_NEW_TOKENS:-3072}"
EVAL_AUTO_RESUME_PASSES="${EVAL_AUTO_RESUME_PASSES:-3}"
EVAL_TOKEN_ESCALATION="${EVAL_TOKEN_ESCALATION:-1024}"
EVAL_CONCURRENCY="${EVAL_CONCURRENCY:-512}"

GENERATION_SEED="${GENERATION_SEED:-42}"
API_TIMEOUT="${API_TIMEOUT:-900}"
# 8560-8577 collides with long-lived qemu Android emulators on this host; keep clear of it.
POLICY_PORT="${POLICY_PORT:-8900}"
JUDGE_PORT="${JUDGE_PORT:-9200}"
GPU_IDS="${GPU_IDS:-0,1,2,3,4,5,6,7}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.90}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-16384}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-65536}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-64}"
SERVER_WAIT_TIMEOUT="${SERVER_WAIT_TIMEOUT:-900}"
SERVER_STOP_TIMEOUT="${SERVER_STOP_TIMEOUT:-60}"
VLLM_PERFORMANCE_MODE="${VLLM_PERFORMANCE_MODE:-throughput}"

KL_COEF="${KL_COEF:-0.2}"
NUM_EPOCHS="${NUM_EPOCHS:-3}"
LR="${LR:-1e-5}"
PER_DEVICE_BATCH="${PER_DEVICE_BATCH:-1}"
GRAD_ACCUM="${GRAD_ACCUM:-2}"
TRAIN_MAX_SEQ="${TRAIN_MAX_SEQ:-6144}"
WARMUP_RATIO="${WARMUP_RATIO:-0.05}"
LORA_RANK="${LORA_RANK:-64}"
LORA_ALPHA="${LORA_ALPHA:-64}"
LORA_DROPOUT="${LORA_DROPOUT:-0.05}"
TRAIN_SAVE_STEPS="${TRAIN_SAVE_STEPS:-100}"
TRAIN_SAVE_TOTAL_LIMIT="${TRAIN_SAVE_TOTAL_LIMIT:-3}"
TRAIN_MAX_STEPS="${TRAIN_MAX_STEPS:-0}"
NUM_GPUS="${NUM_GPUS:-8}"

RESUME="${RESUME:-1}"
DRY_RUN="${DRY_RUN:-0}"
MOCK="${MOCK:-0}"
SKIP_3X8B="${SKIP_3X8B:-0}"
JCA_HTTP_KEEPALIVE="${JCA_HTTP_KEEPALIVE:-1}"
JCA_HTTP_POOL_MAXSIZE="${JCA_HTTP_POOL_MAXSIZE:-128}"
JCA_ENDPOINT_RETRIES="${JCA_ENDPOINT_RETRIES:-2}"
export JCA_HTTP_KEEPALIVE JCA_HTTP_POOL_MAXSIZE JCA_ENDPOINT_RETRIES
