# MATH reproduction of gsm_judge_rl_v13_14b_role_c2c_1_05_1.
# Every value can be overridden from the environment before invoking a stage.

EXPERIMENT_ROOT="${EXPERIMENT_ROOT:-/data/wangyuheng/jca/experiments/math_rl_mas_thinking}"
PROJECT_ROOT="${PROJECT_ROOT:-/data/wangyuheng/jca}"
PYTHONPATH_ROOT="${PYTHONPATH_ROOT:-/data/wangyuheng}"
PYTHON_BIN="${PYTHON_BIN:-/data/conda_envs/qwen35/bin/python}"
VLLM_PYTHON_BIN="${VLLM_PYTHON_BIN:-/data/conda_envs/deep_research/bin/python}"
VLLM_LD_LIBRARY_PATH="${VLLM_LD_LIBRARY_PATH:-/data/conda_envs/deep_research/lib}"
ACCELERATE="${ACCELERATE:-/data/conda_envs/qwen35/bin/accelerate}"

TAG="${TAG:-math_rl_mas_v13_nonthinking_global_turn_json_object_1p7b_4b_8b}"
MATH_DATA_ROOT="${MATH_DATA_ROOT:-${PROJECT_ROOT}/Math/data/MATH}"
ARTIFACT_ROOT="${ARTIFACT_ROOT:-${EXPERIMENT_ROOT}/artifacts/${TAG}}"
RAW_ROLLOUT="${RAW_ROLLOUT:-${ARTIFACT_ROOT}/01_sample/train_raw.jsonl}"
JUDGED_ROLLOUT="${JUDGED_ROLLOUT:-${ARTIFACT_ROOT}/02_score/train_judged.jsonl}"
JUDGE_STATS="${JUDGE_STATS:-${ARTIFACT_ROOT}/02_score/stats.json}"
TRAIN_DATA="${TRAIN_DATA:-${ARTIFACT_ROOT}/03_prepare/train.jsonl}"
HOLDOUT_DATA="${HOLDOUT_DATA:-${ARTIFACT_ROOT}/03_prepare/holdout.jsonl}"
PREPARE_STATS="${PREPARE_STATS:-${ARTIFACT_ROOT}/03_prepare/stats.json}"
MANIFEST="${MANIFEST:-${ARTIFACT_ROOT}/manifest.json}"
RL_ROOT="${RL_ROOT:-${ARTIFACT_ROOT}/04_train/adapters}"
EVAL_OUTPUT="${EVAL_OUTPUT:-${ARTIFACT_ROOT}/05_eval/math_test_seed43.jsonl}"
LOG_ROOT="${LOG_ROOT:-${ARTIFACT_ROOT}/logs}"

MODEL_A1="${MODEL_A1:-/data/wangyuheng/models/Qwen3-1.7B}"
MODEL_A2="${MODEL_A2:-/data/wangyuheng/models/Qwen3-4B}"
MODEL_A3="${MODEL_A3:-/data/wangyuheng/models/Qwen3-8B}"
SFT_ROOT="${SFT_ROOT:-${PROJECT_ROOT}/sft_runs/gsm_fixed_a1_corr30_20260723_v3}"
SFT_A1="${SFT_A1:-${SFT_ROOT}/A1/final}"
SFT_A2="${SFT_A2:-${SFT_ROOT}/A2/final}"
SFT_A3="${SFT_A3:-${SFT_ROOT}/A3/final}"

# MATH has 7,500 train and 5,000 test examples. Defaults use both full splits.
TRAIN_START="${TRAIN_START:-0}"
TRAIN_LIMIT="${TRAIN_LIMIT:-7500}"
EVAL_START="${EVAL_START:-0}"
EVAL_LIMIT="${EVAL_LIMIT:-5000}"
SUBJECTS="${SUBJECTS:-}"
NUM_ROLLOUTS="${NUM_ROLLOUTS:-8}"
T_MAX="${T_MAX:-8}"
MIN_AGENTS_BEFORE_STOP="${MIN_AGENTS_BEFORE_STOP:-1}"
SAMPLE_START_AGENT="${SAMPLE_START_AGENT:-A1}"
SAMPLE_TEMPERATURE="${SAMPLE_TEMPERATURE:-0.9}"
SAMPLE_TOP_P="${SAMPLE_TOP_P:-0.95}"
SAMPLE_MAX_NEW_TOKENS="${SAMPLE_MAX_NEW_TOKENS:-8192}"
SAMPLE_MAX_CONCURRENCY="${SAMPLE_MAX_CONCURRENCY:-128}"
SAMPLE_JSON_TRANSPORT="${SAMPLE_JSON_TRANSPORT:-json_object}"
SAMPLE_GROUP_RETRIES="${SAMPLE_GROUP_RETRIES:-5}"
SAMPLE_STEP_RETRIES="${SAMPLE_STEP_RETRIES:-4}"
SAMPLE_GENERATION_SEED="${SAMPLE_GENERATION_SEED:-42}"
SAMPLE_ENABLE_THINKING="${SAMPLE_ENABLE_THINKING:-0}"
SAMPLE_REQUIRE_THINKING="${SAMPLE_REQUIRE_THINKING:-0}"

# Rollout sampling, RL targets, and policy evaluation all use visible
# non-thinking protocol JSON.
TRAIN_ENABLE_THINKING="${TRAIN_ENABLE_THINKING:-${SAMPLE_ENABLE_THINKING}}"
ENABLE_THINKING="${ENABLE_THINKING:-0}"
REQUIRE_THINKING="${REQUIRE_THINKING:-0}"
ALLOW_THINKING_MODE_MISMATCH="${ALLOW_THINKING_MODE_MISMATCH:-0}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-40960}"
API_TIMEOUT="${API_TIMEOUT:-1800}"

# v13 compact local judge: Qwen3-14B, thinking, canonical discrete scores.
JUDGE_MODEL_PATH="${JUDGE_MODEL_PATH:-/data/wangyuheng/models/Qwen3-14B}"
JUDGE_MAX_MODEL_LEN="${JUDGE_MAX_MODEL_LEN:-32768}"
JUDGE_MAX_TOKENS="${JUDGE_MAX_TOKENS:-8192}"
JUDGE_CONCURRENCY="${JUDGE_CONCURRENCY:-16}"
JUDGE_GROUP_RETRIES="${JUDGE_GROUP_RETRIES:-2}"
JUDGE_PARSE_RETRIES="${JUDGE_PARSE_RETRIES:-2}"
JUDGE_AUTO_RESUME_PASSES="${JUDGE_AUTO_RESUME_PASSES:-5}"
JUDGE_TEMPERATURE="${JUDGE_TEMPERATURE:-0.0}"
JUDGE_TOP_P="${JUDGE_TOP_P:-0.95}"

# Exact v13 data-selection and reward settings.
HOLDOUT_FRACTION="${HOLDOUT_FRACTION:-0.10}"
MIX_A1_CORRECT="${MIX_A1_CORRECT:-0.30}"
MIX_NO_CORRECTION="${MIX_NO_CORRECTION:-0.20}"
MIX_CORRECTION_SUCCESS="${MIX_CORRECTION_SUCCESS:-0.35}"
MIX_CORRECTION_FAILED="${MIX_CORRECTION_FAILED:-0.15}"
BASE_REWARD_WEIGHT="${BASE_REWARD_WEIGHT:-0.35}"
JUDGE_REWARD_WEIGHT="${JUDGE_REWARD_WEIGHT:-0.65}"
TRANSITION_BOOST="${TRANSITION_BOOST:-1.25}"
CORRECT_TO_CORRECT_COEF_A1="${CORRECT_TO_CORRECT_COEF_A1:-1.0}"
CORRECT_TO_CORRECT_COEF_A2="${CORRECT_TO_CORRECT_COEF_A2:-0.5}"
CORRECT_TO_CORRECT_COEF_A3="${CORRECT_TO_CORRECT_COEF_A3:-1.0}"
SEED="${SEED:-42}"

# v13 optimizer settings with format-protected signed-RWR and token-level KL.
KL_COEF="${KL_COEF:-0.1}"
NUM_EPOCHS="${NUM_EPOCHS:-1}"
LR="${LR:-3e-6}"
PER_DEVICE_BATCH="${PER_DEVICE_BATCH:-1}"
GRAD_ACCUM="${GRAD_ACCUM:-2}"
TRAIN_MAX_SEQ="${TRAIN_MAX_SEQ:-8192}"
NUM_GPUS="${NUM_GPUS:-8}"
MIXED_PRECISION="${MIXED_PRECISION:-bf16}"
# Compact PEFT checkpoints make nightly preemption resumable without storing
# the frozen base model. A shorter interval bounds work lost at 08:30.
TRAIN_SAVE_STEPS="${TRAIN_SAVE_STEPS:-25}"
TRAIN_SAVE_TOTAL_LIMIT="${TRAIN_SAVE_TOTAL_LIMIT:-3}"

# Reference-result evaluation policy: random first role, seed 43, deterministic
# generation seed 42, as used by the 0.7197 EM / 0.8115 F1 GSM-HARD run.
EVAL_START_AGENT="${EVAL_START_AGENT:-random}"
EVAL_START_AGENT_SEED="${EVAL_START_AGENT_SEED:-43}"
EVAL_GENERATION_SEED="${EVAL_GENERATION_SEED:-42}"
EVAL_TEMPERATURE="${EVAL_TEMPERATURE:-0.0}"
EVAL_TOP_P="${EVAL_TOP_P:-0.95}"
EVAL_MAX_NEW_TOKENS="${EVAL_MAX_NEW_TOKENS:-8192}"
EVAL_MAX_CONCURRENCY="${EVAL_MAX_CONCURRENCY:-256}"
EVAL_GROUP_RETRIES="${EVAL_GROUP_RETRIES:-0}"
EVAL_STEP_RETRIES="${EVAL_STEP_RETRIES:-2}"

RESUME="${RESUME:-0}"
DRY_RUN="${DRY_RUN:-0}"
WAIT_FOR_GPUS="${WAIT_FOR_GPUS:-1}"
GPU_POLL_SECONDS="${GPU_POLL_SECONDS:-60}"
GPU_IDLE_CHECKS="${GPU_IDLE_CHECKS:-2}"
