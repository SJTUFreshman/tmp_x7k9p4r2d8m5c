# MATH Qwen3-14B SAS self-RL defaults. Environment variables override all values.

SCRIPT_DIR="${SCRIPT_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
EXPERIMENT_ROOT="${EXPERIMENT_ROOT:-$(cd -- "${SCRIPT_DIR}/../.." && pwd)}"
BUNDLED_PROJECT_ROOT="${EXPERIMENT_ROOT}/vendor/jca"
BUNDLED_PYTHONPATH_ROOT="${EXPERIMENT_ROOT}/vendor"
RESOURCE_PROJECT_ROOT="${RESOURCE_PROJECT_ROOT:-${EXPERIMENT_ROOT}/resources}"
PROJECT_ROOT="$BUNDLED_PROJECT_ROOT"
RUNTIME_ENV_ROOT="${RUNTIME_ENV_ROOT:-/data/home/scwb515/.conda/envs/swift}"
PYTHON_BIN="${PYTHON_BIN:-${RUNTIME_ENV_ROOT}/bin/python}"
ACCELERATE="${ACCELERATE:-${RUNTIME_ENV_ROOT}/bin/accelerate}"
VLLM_PYTHON_BIN="${VLLM_PYTHON_BIN:-${RUNTIME_ENV_ROOT}/bin/python}"
VLLM_LD_LIBRARY_PATH="${VLLM_LD_LIBRARY_PATH:-${RUNTIME_ENV_ROOT}/lib}"
PYTHONPATH_ROOT="$BUNDLED_PYTHONPATH_ROOT"
PYTHON_COMPAT_DIR="${PYTHON_COMPAT_DIR:-${PROJECT_ROOT}/scripts/gsm_judge_rl/python_compat}"

MODEL="${MODEL:-${RESOURCE_PROJECT_ROOT}/models/Qwen3-14B}"
MATH_DATA_ROOT="${MATH_DATA_ROOT:-${RESOURCE_PROJECT_ROOT}/downloads/hendrycks_math}"
RUN_ID="${RUN_ID:-math_sas14b_self_rl_shard04_nonthinking_v1_20260831}"
RUN_DIR="${RUN_DIR:-${EXPERIMENT_ROOT}/artifacts/14b_self_rl/${RUN_ID}}"

TRAIN_START="${TRAIN_START:-0}"
TRAIN_LIMIT="${TRAIN_LIMIT:-7500}"
EVAL_START="${EVAL_START:-0}"
EVAL_LIMIT="${EVAL_LIMIT:-500}"
EVAL_PROBLEM_IDS_FILE="${EVAL_PROBLEM_IDS_FILE:-${MATH_DATA_ROOT}/splits/test_10x500_seed42/shard_04.jsonl}"
SUBJECTS="${SUBJECTS:-}"
NUM_ROLLOUTS="${NUM_ROLLOUTS:-8}"

ROLLOUT_TEMPERATURE="${ROLLOUT_TEMPERATURE:-0.9}"
ROLLOUT_TOP_P="${ROLLOUT_TOP_P:-0.95}"
ROLLOUT_MAX_NEW_TOKENS="${ROLLOUT_MAX_NEW_TOKENS:-8192}"
ROLLOUT_CONCURRENCY="${ROLLOUT_CONCURRENCY:-128}"
PROTOCOL_RETRIES="${PROTOCOL_RETRIES:-4}"

JUDGE_TEMPERATURE="${JUDGE_TEMPERATURE:-0.0}"
JUDGE_TOP_P="${JUDGE_TOP_P:-0.95}"
JUDGE_MAX_NEW_TOKENS="${JUDGE_MAX_NEW_TOKENS:-8192}"
JUDGE_CONCURRENCY="${JUDGE_CONCURRENCY:-64}"
JUDGE_RETRIES="${JUDGE_RETRIES:-2}"
JUDGE_AUTO_RESUME_PASSES="${JUDGE_AUTO_RESUME_PASSES:-5}"
OUTCOME_WEIGHT="${OUTCOME_WEIGHT:-0.35}"
PROCESS_WEIGHT="${PROCESS_WEIGHT:-0.65}"

EVAL_TEMPERATURE="${EVAL_TEMPERATURE:-0.0}"
EVAL_TOP_P="${EVAL_TOP_P:-0.95}"
EVAL_MAX_NEW_TOKENS="${EVAL_MAX_NEW_TOKENS:-8192}"
EVAL_CONCURRENCY="${EVAL_CONCURRENCY:-128}"
EVAL_ENABLE_THINKING="${EVAL_ENABLE_THINKING:-0}"
EVAL_REQUIRE_THINKING="${EVAL_REQUIRE_THINKING:-0}"
RUN_BASE_EVAL="${RUN_BASE_EVAL:-0}"
EVAL_ONLY="${EVAL_ONLY:-0}"
EVAL_ADAPTER="${EVAL_ADAPTER:-}"
EVAL_OUTPUT="${EVAL_OUTPUT:-}"
EVAL_STATS="${EVAL_STATS:-}"
EVAL_TAG="${EVAL_TAG:-rl}"

GENERATION_SEED="${GENERATION_SEED:-42}"
API_TIMEOUT="${API_TIMEOUT:-900}"
POLICY_PORT="${POLICY_PORT:-8501}"
JUDGE_PORT="${JUDGE_PORT:-8502}"
VLLM_DP_MASTER_PORT="${VLLM_DP_MASTER_PORT:-25000}"
GPU_IDS="${GPU_IDS:-auto}"
DP_SIZE="${DP_SIZE:-auto}"
TP_SIZE="${TP_SIZE:-1}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-40960}"
JUDGE_MAX_MODEL_LEN="${JUDGE_MAX_MODEL_LEN:-32768}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.85}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-65536}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
SERVER_WAIT_TIMEOUT="${SERVER_WAIT_TIMEOUT:-900}"
SERVER_STOP_TIMEOUT="${SERVER_STOP_TIMEOUT:-45}"

KL_COEF="${KL_COEF:-0.1}"
NUM_EPOCHS="${NUM_EPOCHS:-3}"
LR="${LR:-3e-6}"
PER_DEVICE_BATCH="${PER_DEVICE_BATCH:-1}"
GRAD_ACCUM="${GRAD_ACCUM:-2}"
TRAIN_MAX_SEQ="${TRAIN_MAX_SEQ:-8192}"
WARMUP_RATIO="${WARMUP_RATIO:-0.05}"
LORA_RANK="${LORA_RANK:-64}"
LORA_ALPHA="${LORA_ALPHA:-64}"
LORA_DROPOUT="${LORA_DROPOUT:-0.05}"
TRAIN_SAVE_STEPS="${TRAIN_SAVE_STEPS:-0}"
TRAIN_SAVE_TOTAL_LIMIT="${TRAIN_SAVE_TOTAL_LIMIT:-3}"
TRAIN_RESUME_CHECKPOINT="${TRAIN_RESUME_CHECKPOINT:-}"
NUM_GPUS="${NUM_GPUS:-auto}"
TARGET_EFFECTIVE_BATCH="${TARGET_EFFECTIVE_BATCH:-16}"
AUTO_SCALE_GRAD_ACCUM="${AUTO_SCALE_GRAD_ACCUM:-1}"
ALLOW_WORLD_SIZE_CHANGE_RESUME="${ALLOW_WORLD_SIZE_CHANGE_RESUME:-1}"
MAX_TRAIN_STEPS="${MAX_TRAIN_STEPS:-0}"

# A completed rollout/judge pair is immutable for this run.  On a restart,
# avoid loading two more 14B servers just to discover that there is no work.
SKIP_ROLLOUT_SCORE_IF_COMPLETE="${SKIP_ROLLOUT_SCORE_IF_COMPLETE:-1}"

RESUME="${RESUME:-1}"
DRY_RUN="${DRY_RUN:-0}"
WAIT_FOR_IDLE_GPUS="${WAIT_FOR_IDLE_GPUS:-1}"
GPU_IDLE_TIMEOUT_SECONDS="${GPU_IDLE_TIMEOUT_SECONDS:-86400}"
GPU_CONTINUE_IDLE_TIMEOUT_SECONDS="${GPU_CONTINUE_IDLE_TIMEOUT_SECONDS:-300}"
GPU_POLL_SECONDS="${GPU_POLL_SECONDS:-10}"
GPU_IDLE_CHECKS="${GPU_IDLE_CHECKS:-2}"
GPU_IDLE_MAX_MEMORY_MIB="${GPU_IDLE_MAX_MEMORY_MIB:-2048}"
GPU_CLEANUP_GRACE_SECONDS="${GPU_CLEANUP_GRACE_SECONDS:-15}"
GPU_CLEANUP_TIMEOUT_SECONDS="${GPU_CLEANUP_TIMEOUT_SECONDS:-120}"
CLEANUP_ON_FAILURE="${CLEANUP_ON_FAILURE:-1}"
JCA_MATH_OWNER="${JCA_MATH_OWNER:-$RUN_ID}"

RAW_ROLLOUT="${RAW_ROLLOUT:-${RUN_DIR}/01_rollout/train_raw.jsonl}"
ROLLOUT_STATS="${ROLLOUT_STATS:-${RUN_DIR}/01_rollout/stats.json}"
JUDGED_ROLLOUT="${JUDGED_ROLLOUT:-${RUN_DIR}/02_score/train_judged.jsonl}"
JUDGE_AUDIT="${JUDGE_AUDIT:-${RUN_DIR}/02_score/judge_audit.jsonl}"
JUDGE_STATS="${JUDGE_STATS:-${RUN_DIR}/02_score/stats.json}"
TRAIN_OUT="${TRAIN_OUT:-${RUN_DIR}/03_train/adapter}"
BASE_EVAL_OUTPUT="${BASE_EVAL_OUTPUT:-${RUN_DIR}/04_eval/base_test.jsonl}"
BASE_EVAL_STATS="${BASE_EVAL_STATS:-${RUN_DIR}/04_eval/base_summary.json}"
RL_EVAL_OUTPUT="${RL_EVAL_OUTPUT:-${RUN_DIR}/04_eval/rl_test.jsonl}"
RL_EVAL_STATS="${RL_EVAL_STATS:-${RUN_DIR}/04_eval/rl_summary.json}"
